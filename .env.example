# Copy this file to .env.local and fill in the values.
# Never commit .env.local - it is already in .gitignore.

# From https://console.groq.com  ->  API Keys  ->  Create API Key
GROQ_API_KEY=gsk_your_key_here

# From your Neon dashboard -> Connection string.
# Optional: the chat works without it, it just will not save messages.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Your first name, used to label your rows in the shared class database.
# Everyone on the course writes to the same database, so this is how you
# find your own messages on the /data page.
STUDENT_NAME=your_first_name

# Tracing, from https://cloud.langfuse.com -> Settings -> API Keys.
# Optional: without these the agent still runs and every run is still shown
# on the /runs page. You only lose the copy kept in the Langfuse dashboard.
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key

# Only needed if you self-host Langfuse or use a different region.
# Defaults to https://cloud.langfuse.com. Either spelling works: the Langfuse
# Python SDK calls it LANGFUSE_HOST and the JavaScript one LANGFUSE_BASE_URL.
# LANGFUSE_HOST=https://cloud.langfuse.com
